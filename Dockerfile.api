FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend_main.py backend_store.py seed_units.json ./
RUN mkdir -p /app/data

CMD ["uvicorn", "backend_main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
